{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Mods-For-Lupin",
        "sources": "https://github.com/Mods-For-Lupin"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.cursee.more_beautiful_torches.MoreBeautifulTorchesModFabric"
        ],
        "client": [
            "com.cursee.more_beautiful_torches.MoreBeautifulTorchesClientFabric"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}",
        "monolib": ">=3.0.1"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  